---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="eyebrow animate-fade">Error 404</p>
    <h1 class="mt-4 text-5xl sm:text-7xl">
      <span class="reveal-line"><span>This page has</span></span>
      <span class="reveal-line"><span style="--i:1" class="text-terracotta italic">slipped off the rack.</span></span>
    </h1>
    <p class="mt-6 max-w-md animate-fade text-muted [animation-delay:300ms]">The link may be old or the piece may have sold out. Let's get you back to the collection.</p>
    <div class="mt-9 flex animate-fade flex-wrap justify-center gap-3 [animation-delay:450ms]">
      <a href="/shop" class="btn btn-primary">Browse the collection</a>
      <a href="/" class="btn btn-outline">Go home</a>
    </div>
  </section>
</Base>
