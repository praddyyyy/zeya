---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import ProductCard from '../../components/ProductCard.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { catalog, categoryLabel } from '../../config/catalog';
import { site } from '../../config/site';
import Base from '../../layouts/Base.astro';
import { discountPercent, formatPrice } from '../../lib/format';
import { getProducts, productUrl, type Product } from '../../lib/products';
import { enquiryUrl } from '../../scripts/whatsapp';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.id }, props: { product, products } }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  products: Product[];
}

const { product, products } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const url = productUrl(product);
const absoluteUrl = new URL(url, Astro.site).href;
const off = discountPercent(data.price, data.mrp);
const category = categoryLabel(data.gender, data.category);
const thumb = await getImage({ src: data.images[0], width: 200, format: 'webp' });

// Data the cart needs, read by src/scripts/product.ts
const cartData = JSON.stringify({ slug: product.id, name: data.name, code: data.code, price: data.price, image: thumb.src, url });

const related = [
  ...products.filter((p) => p.id !== product.id && p.data.category === data.category),
  ...products.filter((p) => p.id !== product.id && p.data.gender === data.gender && p.data.category !== data.category),
].slice(0, 4);

const details = [
  { title: 'Details & fit', rows: [['Fabric', data.fabric], ['Fit', data.fit], ['Product code', data.code]] },
  { title: 'Care', rows: [['Care', data.care]] },
].map((d) => ({ ...d, rows: d.rows.filter((r): r is [string, string] => Boolean(r[1])) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  sku: data.code,
  image: new URL((await getImage({ src: data.images[0], width: 1200, format: 'jpg' })).src, Astro.site).href,
  description: product.body?.trim(),
  brand: { '@type': 'Brand', name: site.name },
  offers: {
    '@type': 'Offer',
    url: absoluteUrl,
    priceCurrency: 'INR',
    price: data.price,
    availability: `https://schema.org/${data.inStock ? 'InStock' : 'OutOfStock'}`,
  },
};
---

<Base title={data.name} description={product.body?.trim().slice(0, 155)} image={data.images[0]} jsonLd={jsonLd}>
  <div class="container-x pt-6 pb-20 sm:pt-8">
    <nav class="animate-fade text-xs text-muted" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-espresso">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${data.gender}`} class="hover:text-espresso">{catalog[data.gender].label}</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/${data.gender}/${data.category}`} class="hover:text-espresso">{category}</a></li>
      </ol>
    </nav>

    <div class="mt-6 grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Gallery -->
      <div class="lg:col-span-7">
        <div
          data-gallery-track
          class="no-scrollbar -mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 sm:mx-0 sm:px-0 lg:grid lg:grid-cols-2 lg:overflow-visible"
        >
          {
            data.images.map((img, i) => (
              <div class:list={['w-[86%] shrink-0 snap-center overflow-hidden rounded-2xl bg-sand sm:w-[70%] lg:w-auto', { 'lg:col-span-2': i === 0 || data.images.length <= 2 }]}>
                <Image
                  src={img}
                  alt={i === 0 ? data.name : `${data.name}, view ${i + 1}`}
                  widths={[480, 720, 960, 1200]}
                  sizes="(min-width: 1024px) 55vw, 86vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  class="aspect-4/5 size-full object-cover"
                  style={i === 0 ? `view-transition-name: product-${product.id}` : undefined}
                />
              </div>
            ))
          }
        </div>
        {
          data.images.length > 1 && (
            <div class="mt-4 flex justify-center gap-2 lg:hidden" aria-hidden="true">
              {data.images.map((_, i) => (
                <button
                  type="button"
                  tabindex="-1"
                  data-gallery-go={i}
                  data-active={i === 0 ? '' : undefined}
                  class="h-1.5 w-1.5 rounded-full bg-espresso/20 transition-all duration-500 data-active:w-6 data-active:bg-espresso"
                />
              ))}
            </div>
          )
        }
      </div>

      <!-- Info -->
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-24">
          <p class="eyebrow animate-fade">{catalog[data.gender].label} · {category}</p>
          <h1 class="mt-3 text-4xl leading-[1.05] sm:text-5xl">
            <span class="reveal-line"><span>{data.name}</span></span>
          </h1>
          <div class="mt-5 flex animate-fade items-baseline gap-3 [animation-delay:150ms]">
            <span class="text-2xl font-semibold">{formatPrice(data.price)}</span>
            {
              off > 0 && (
                <>
                  <span class="text-muted line-through">{formatPrice(data.mrp!)}</span>
                  <span class="rounded-full bg-terracotta/10 px-2.5 py-1 text-xs font-semibold text-terracotta">Save {off}%</span>
                </>
              )
            }
          </div>
          <p class="mt-1 text-xs text-muted">Inclusive of all taxes. Delivery charges confirmed on WhatsApp.</p>

          <form data-product-form data-astro-reload data-product={cartData} class="mt-8 animate-fade space-y-7 [animation-delay:250ms]">
            {
              data.colors.length > 1 ? (
                <fieldset>
                  <legend class="text-sm">
                    Colour: <span data-color-label class="font-semibold">{data.colors[0]}</span>
                  </legend>
                  <div class="mt-3 flex flex-wrap gap-2">
                    {data.colors.map((c, i) => (
                      <label class="relative cursor-pointer">
                        <input type="radio" name="color" value={c} checked={i === 0} class="peer sr-only" />
                        <span class="chip">{c}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ) : (
                <>
                  <input type="hidden" name="color" value={data.colors[0] ?? ''} />
                  {data.colors[0] && (
                    <p class="text-sm">
                      Colour: <span class="font-semibold">{data.colors[0]}</span>
                    </p>
                  )}
                </>
              )
            }

            <fieldset data-size-group>
              <div class="flex items-baseline justify-between">
                <legend class="text-sm">Size</legend>
                <a href="/contact#size-guide" class="text-xs text-muted underline underline-offset-4 hover:text-espresso">Size guide</a>
              </div>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  data.sizes.map((s) => (
                    <label class="relative cursor-pointer">
                      <input type="radio" name="size" value={s} checked={data.sizes.length === 1} class="peer sr-only" />
                      <span class="chip min-w-12 justify-center">{s}</span>
                    </label>
                  ))
                }
              </div>
              <p data-size-error class="mt-2 hidden text-sm text-terracotta" role="alert">Please choose a size.</p>
            </fieldset>

            <div class="flex items-center gap-4">
              <span class="text-sm">Quantity</span>
              <div class="flex items-center rounded-full border border-line">
                <button type="button" data-qty-step="-1" class="grid size-10 place-items-center rounded-full hover:bg-sand" aria-label="Decrease quantity">−</button>
                <input name="qty" type="number" value="1" min="1" max="20" inputmode="numeric" aria-label="Quantity" class="w-8 bg-transparent text-center tabular-nums [appearance:textfield] focus:outline-none [&::-webkit-inner-spin-button]:appearance-none" />
                <button type="button" data-qty-step="1" class="grid size-10 place-items-center rounded-full hover:bg-sand" aria-label="Increase quantity">+</button>
              </div>
            </div>

            {
              data.inStock ? (
                <div class="grid gap-3 sm:grid-cols-2">
                  <button type="submit" name="intent" value="add" class="group btn btn-primary">
                    <span class="group-data-added:hidden">Add to bag</span>
                    <span class="hidden items-center gap-2 group-data-added:inline-flex">
                      <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                      Added to bag
                    </span>
                  </button>
                  <button type="submit" name="intent" value="buy" class="btn btn-whatsapp">
                    <WhatsAppIcon /> Buy on WhatsApp
                  </button>
                </div>
              ) : (
                <div class="rounded-2xl bg-cream p-5 text-sm">
                  <p class="font-semibold">Currently sold out</p>
                  <p class="mt-1 text-muted">Message us — we may be able to make another for you.</p>
                </div>
              )
            }
          </form>

          <a
            href={enquiryUrl(`Hi ${site.name}! I have a question about ${data.name} (${data.code}): ${absoluteUrl}`)}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2 text-sm text-muted hover:text-espresso"
          >
            <WhatsAppIcon class="size-4" /> Questions? Ask us about this piece
          </a>

          <div class="prose-zeya mt-10 border-t border-line pt-8 text-[0.95rem] leading-relaxed text-espresso/85">
            <Content />
          </div>

          {
            data.highlights.length > 0 && (
              <ul class="mt-6 space-y-2 text-sm">
                {data.highlights.map((h) => (
                  <li class="flex gap-3">
                    <span class="mt-2 size-1.5 shrink-0 rounded-full bg-gold" />
                    {h}
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-8 divide-y divide-line border-y border-line">
            {
              details.filter((d) => d.rows.length).map((d) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold [&::-webkit-details-marker]:hidden">
                    {d.title}
                    <span class="text-lg font-light transition-transform duration-300 group-open:rotate-45">+</span>
                  </summary>
                  <dl class="mt-3 space-y-1.5 text-sm">
                    {d.rows.map(([k, v]) => (
                      <div class="flex gap-4">
                        <dt class="w-28 shrink-0 text-muted">{k}</dt>
                        <dd>{v}</dd>
                      </div>
                    ))}
                  </dl>
                </details>
              ))
            }
            <details class="group py-4">
              <summary class="flex cursor-pointer list-none items-center justify-between text-sm font-semibold [&::-webkit-details-marker]:hidden">
                Delivery & returns
                <span class="text-lg font-light transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 text-sm text-muted">
                We ship across India; delivery time and charges are confirmed when we reply on WhatsApp. Exchanges are accepted within 7 days for unused pieces with tags.
                <a href="/contact#faq" class="underline underline-offset-4">Read the full policy</a>.
              </p>
            </details>
          </div>
        </div>
      </div>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="border-t border-line bg-cream/50 py-20">
        <div class="container-x">
          <div class="flex items-end justify-between gap-6" data-reveal>
            <h2 class="text-3xl sm:text-4xl">You may also like</h2>
            <a href={`/${data.gender}/${data.category}`} class="link-underline text-sm whitespace-nowrap">
              View all {category.toLowerCase()}
            </a>
          </div>
          <div class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-4">
            {related.map((p, i) => <ProductCard product={p} index={i} />)}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  .prose-zeya :global(p + p) {
    margin-top: 1em;
  }
</style>
