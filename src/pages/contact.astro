---
import HowToOrder from '../components/HowToOrder.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { site } from '../config/site';
import Base from '../layouts/Base.astro';
import { enquiryUrl } from '../scripts/whatsapp';

// Placeholder policies — replace with the real ones before launch.
const faqs = [
  { q: 'How do I place an order?', a: 'Add pieces to your bag and tap “Checkout on WhatsApp”. WhatsApp opens with your order written out — just send it and we’ll reply to confirm.' },
  { q: 'How can I pay?', a: 'We accept UPI, bank transfer and cash on delivery in select areas. We’ll share payment details when we confirm your order.' },
  { q: 'Where do you deliver, and how long does it take?', a: 'We ship across India. Orders are usually dispatched within 2–3 working days and arrive in 4–7 days depending on your location.' },
  { q: 'What does delivery cost?', a: 'Delivery charges depend on your pincode and order size. We’ll confirm the exact amount on WhatsApp before you pay.' },
  { q: 'Can I exchange or return?', a: 'Unused pieces with tags can be exchanged within 7 days of delivery. Message us with your order details and we’ll arrange it.' },
  { q: 'Do you take custom or bulk orders?', a: 'Yes — as manufacturers we can often adjust sizes or make pieces in other colours. Message us with what you need.' },
];

const sizeChart = {
  head: ['Size', 'Chest (in)', 'Waist (in)', 'Length (in)'],
  rows: [
    ['XS', '34', '28', '26'],
    ['S', '36', '30', '27'],
    ['M', '38', '32', '28'],
    ['L', '40', '34', '29'],
    ['XL', '42', '36', '30'],
    ['XXL', '44', '38', '31'],
  ],
};

const contacts = [
  { label: 'WhatsApp', value: 'Chat with us', href: enquiryUrl(), external: true },
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'Instagram', value: '@zeya', href: site.instagram, external: true },
];
---

<Base title="Contact & help" description="Contact Zeya on WhatsApp, read our shipping and returns policy, and find your size.">
  <section class="container-x pt-10 pb-16 sm:pt-16">
    <p class="eyebrow animate-fade">We're here to help</p>
    <h1 class="mt-4 text-5xl sm:text-7xl">
      <span class="reveal-line"><span>Say hello</span></span>
    </h1>
    <p class="mt-5 max-w-lg animate-fade text-muted [animation-delay:200ms]">
      The quickest way to reach us is WhatsApp — we usually reply within a few hours during {site.hours.toLowerCase()}.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        contacts.map((c, i) => (
          <a
            href={c.href}
            target={c.external ? '_blank' : undefined}
            rel={c.external ? 'noopener' : undefined}
            class="group rounded-2xl border border-line p-6 transition-colors duration-300 hover:border-espresso hover:bg-cream"
            data-reveal
            style={`--i:${i}`}
          >
            <p class="eyebrow">{c.label}</p>
            <p class="mt-3 flex items-center gap-2 font-serif text-xl break-all">
              {c.label === 'WhatsApp' && <WhatsAppIcon class="size-5 shrink-0 text-whatsapp" />}
              {c.value}
            </p>
          </a>
        ))
      }
      <div class="rounded-2xl border border-line p-6" data-reveal style="--i:3">
        <p class="eyebrow">Visit</p>
        <address class="mt-3 text-sm leading-relaxed not-italic">
          {site.address.map((line) => <span class="block">{line}</span>)}
          <span class="mt-2 block text-muted">{site.hours}</span>
        </address>
      </div>
    </div>
  </section>

  <div class="border-t border-line">
    <HowToOrder />
  </div>

  <section id="faq" class="scroll-mt-24 bg-cream py-20 sm:py-28">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">FAQ</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">Shipping, payment & returns</h2>
      </div>
      <div class="divide-y divide-line border-y border-line lg:col-span-8">
        {
          faqs.map((f, i) => (
            <details class="group py-5" data-reveal style={`--i:${i % 3}`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl [&::-webkit-details-marker]:hidden">
                {f.q}
                <span class="grid size-8 shrink-0 place-items-center rounded-full border border-line font-sans text-lg font-light transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 max-w-2xl pr-10 text-sm leading-relaxed text-muted">{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="size-guide" class="container-x scroll-mt-24 py-20 sm:py-28">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow">Size guide</p>
        <h2 class="mt-3 text-4xl sm:text-5xl">Find your fit</h2>
        <p class="mt-4 text-sm text-muted">
          Body measurements in inches. Sarees are free size. Trouser sizes refer to waist in inches. Between sizes? Message us and we'll help.
        </p>
      </div>
      <div class="overflow-x-auto lg:col-span-8" data-reveal style="--i:1">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-espresso/20">
              {sizeChart.head.map((h) => <th class="py-3 pr-6 font-semibold">{h}</th>)}
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              sizeChart.rows.map((r) => (
                <tr class="transition-colors hover:bg-cream">
                  {r.map((c, i) => (
                    <td class:list={['py-3 pr-6', { 'font-semibold': i === 0 }]}>{c}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>
