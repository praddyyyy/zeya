---
import type { Product } from '../lib/products';
import ProductCard from './ProductCard.astro';

interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
  products: Product[];
  links: { label: string; href: string; current?: boolean }[];
}

const { eyebrow, title, intro, products, links } = Astro.props;

// Offer only sizes that exist in this listing, in a sensible order.
const sizeOrder = ['XS', 'S', 'M', 'L', 'XL', 'XXL', 'Free Size'];
const rank = (s: string) => {
  if (sizeOrder.includes(s)) return sizeOrder.indexOf(s);
  const waist = Number(s);
  return Number.isNaN(waist) ? 999 : 100 + waist;
};
const sizes = [...new Set(products.flatMap((p) => p.data.sizes))].sort((a, b) => rank(a) - rank(b));
---

<section class="container-x pt-10 pb-24 sm:pt-14" data-shop>
  <header class="max-w-2xl">
    <p class="eyebrow animate-fade">{eyebrow}</p>
    <h1 class="mt-3 text-5xl sm:text-6xl">
      <span class="reveal-line"><span>{title}</span></span>
    </h1>
    {intro && <p class="mt-4 animate-fade text-muted [animation-delay:200ms]">{intro}</p>}
  </header>

  <nav class="no-scrollbar -mx-4 mt-8 flex gap-2 overflow-x-auto px-4 sm:mx-0 sm:px-0" aria-label="Categories">
    {links.map((l) => <a href={l.href} class="chip" aria-current={l.current ? 'page' : undefined}>{l.label}</a>)}
  </nav>

  <div class="mt-6 flex flex-col gap-4 border-y border-line py-4 sm:flex-row sm:items-center sm:justify-between">
    <div role="group" aria-labelledby="size-filter-label" class="flex min-w-0 items-center gap-3">
      <span id="size-filter-label" class="eyebrow shrink-0">Size</span>
      <div class="no-scrollbar -mr-4 flex min-w-0 gap-1.5 overflow-x-auto pr-4 sm:mr-0 sm:pr-0">
        {
          sizes.map((s) => (
            <label class="relative cursor-pointer">
              <input type="checkbox" name="size" value={s} class="peer sr-only" />
              <span class="chip px-3 py-1.5 text-xs">{s}</span>
            </label>
          ))
        }
      </div>
      <button type="button" data-shop-clear class="hidden shrink-0 text-xs text-muted underline underline-offset-4 hover:text-espresso">Clear</button>
    </div>
    <div class="flex items-center justify-between gap-4 sm:justify-end">
      <span data-shop-count class="text-xs text-muted" aria-live="polite">{products.length} pieces</span>
      <label class="flex items-center gap-2 text-sm">
        <span class="sr-only">Sort by</span>
        <select name="sort" class="cursor-pointer rounded-full border border-line bg-transparent py-2 pr-8 pl-4 text-sm focus:border-espresso focus:outline-none">
          <option value="featured">Featured</option>
          <option value="new">New arrivals</option>
          <option value="price-asc">Price: low to high</option>
          <option value="price-desc">Price: high to low</option>
        </select>
      </label>
    </div>
  </div>

  <div data-shop-grid class="mt-10 grid grid-cols-2 gap-x-4 gap-y-12 sm:gap-x-6 lg:grid-cols-4">
    {products.map((p, i) => <ProductCard product={p} index={i} />)}
  </div>

  <div data-shop-empty class="hidden py-20 text-center">
    <p class="font-serif text-2xl">Nothing in that size yet</p>
    <p class="mt-2 text-sm text-muted">Try another size — or message us, we may be able to make it for you.</p>
  </div>
</section>
