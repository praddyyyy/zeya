---
import { Image } from 'astro:assets';
import lookAnarkali from '../assets/hero/look-anarkali.jpg';
import lookSaree from '../assets/hero/look-saree.jpg';
import lookShirt from '../assets/hero/look-shirt.jpg';

// Slides for the arch slideshow. Swap images/links here.
const looks = [
  { image: lookSaree, title: 'The Silk Saree', label: 'Women · Sarees', href: '/women/sarees' },
  { image: lookAnarkali, title: 'Festive Anarkali', label: 'Women · Kurtis', href: '/women/kurtis' },
  { image: lookShirt, title: 'Everyday Shirting', label: 'Men · Shirts', href: '/men/shirts' },
];
const SLIDE_MS = 6000;
---

<section data-hero class="hero relative isolate overflow-hidden" style={`--slide-ms:${SLIDE_MS}ms`}>
  <!-- Giant background wordmark -->
  <div class="hero-mark pointer-events-none absolute inset-x-0 bottom-[-0.2em] -z-10 flex justify-center font-serif leading-none font-light text-sand/70 select-none" aria-hidden="true">
    {'ZEYA'.split('').map((l, i) => <span style={`--i:${i}`}>{l}</span>)}
  </div>

  <div class="container-x grid gap-x-8 gap-y-10 pt-8 pb-16 sm:pt-12 lg:min-h-[calc(100svh-6.5rem)] lg:grid-cols-12 lg:grid-rows-[auto_auto] lg:content-center lg:gap-y-8 lg:pt-4 lg:pb-20">
    <!-- Headline -->
    <div class="lg:col-span-4 lg:row-start-1 lg:self-end">
      <p class="eyebrow animate-fade">New season · Made in our workshop</p>
      <h1 class="mt-5 text-[3rem] leading-[0.98] sm:text-7xl lg:text-[clamp(3.6rem,8.2svh,5.4rem)]">
        <span class="reveal-line"><span style="--i:0">Woven</span></span>
        <span class="reveal-line"><span style="--i:1">with care,</span></span>
        <span class="reveal-line"><span style="--i:2" class="text-terracotta italic">worn with</span></span>
        <span class="reveal-line"><span style="--i:3" class="text-terracotta italic">pride.</span></span>
      </h1>
    </div>

    <!-- Intro + calls to action (below the photo on mobile) -->
    <div class="order-last lg:order-none lg:col-span-4 lg:col-start-1 lg:row-start-2 lg:self-start">
      <p class="max-w-sm animate-fade leading-relaxed text-muted [animation-delay:650ms]">
        Sarees, kurtis and everyday menswear — designed and made by us, ordered in a single message on WhatsApp.
      </p>
      <div class="mt-8 flex animate-fade flex-wrap gap-3 [animation-delay:800ms]">
        <a href="/women" class="btn btn-primary">
          Shop Women
          <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/men" class="btn btn-outline">Shop Men</a>
      </div>
    </div>

    <!-- Arch slideshow -->
    <div class="relative mx-auto w-full max-w-[22rem] sm:max-w-sm lg:col-span-4 lg:col-start-5 lg:row-span-2 lg:row-start-1 lg:max-w-[min(100%,calc((100svh-12rem)*5/7))] lg:self-center">
      <div class="hero-arch relative aspect-[5/7] overflow-hidden bg-sand shadow-2xl shadow-espresso/15">
        {
          looks.map((look, i) => (
            <a
              href={look.href}
              data-hero-slide
              data-active={i === 0 ? '' : undefined}
              tabindex={i === 0 ? undefined : -1}
              aria-hidden={i === 0 ? undefined : 'true'}
              class="hero-slide absolute inset-0"
            >
              <Image
                src={look.image}
                alt={`${look.title} — ${look.label}`}
                widths={[400, 640, 900, 1200]}
                sizes="(min-width: 1024px) 32vw, (min-width: 640px) 24rem, 90vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
                class="size-full object-cover"
              />
            </a>
          ))
        }
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-espresso/45 to-transparent"></div>
        <p class="pointer-events-none absolute inset-x-0 bottom-5 text-center text-[0.65rem] font-semibold tracking-[0.3em] text-ivory/90 uppercase">
          Look <span data-hero-index>01</span> / {String(looks.length).padStart(2, '0')}
        </p>
      </div>
    </div>

    <!-- Look details + controls -->
    <div class="flex flex-col gap-6 pt-4 lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:items-end lg:gap-8 lg:self-end lg:pt-0 lg:pb-10 lg:text-right">
      <div class="min-h-[5.5rem] animate-fade [animation-delay:900ms]" aria-live="polite">
        {
          looks.map((look, i) => (
            <div data-hero-caption class:list={['hero-caption', { hidden: i !== 0 }]}>
              <p class="eyebrow">{look.label}</p>
              <a href={look.href} class="group mt-2 inline-flex items-center gap-3 font-serif text-3xl lg:text-4xl">
                <span class="link-underline">{look.title}</span>
                <svg viewBox="0 0 24 24" class="size-5 transition-transform duration-500 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </a>
            </div>
          ))
        }
      </div>

      <div class="flex w-full max-w-xs animate-fade gap-2 [animation-delay:1s]" role="tablist" aria-label="Choose a look">
        {
          looks.map((look, i) => (
            <button
              type="button"
              role="tab"
              data-hero-go={i}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={look.title}
              class="group relative h-8 flex-1 cursor-pointer"
            >
              <span class="absolute inset-x-0 top-1/2 h-0.5 -translate-y-1/2 overflow-hidden rounded-full bg-espresso/15">
                <span class="hero-progress absolute inset-0 origin-left scale-x-0 bg-espresso" />
              </span>
            </button>
          ))
        }
      </div>

      <ul class="hidden animate-fade flex-col gap-2 text-xs text-muted [animation-delay:1.1s] lg:flex">
        <li><span class="mr-2 text-gold">✦</span>Made in-house, never outsourced</li>
        <li><span class="mr-2 text-gold">✦</span>Factory-direct prices</li>
        <li><span class="mr-2 text-gold">✦</span>Personal service on WhatsApp</li>
      </ul>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="pointer-events-none absolute bottom-6 left-1/2 hidden -translate-x-1/2 animate-fade flex-col items-center gap-2 [animation-delay:1.4s] lg:flex" aria-hidden="true">
    <span class="text-[0.6rem] font-semibold tracking-[0.3em] text-muted uppercase">Scroll</span>
    <span class="hero-scroll block h-10 w-px overflow-hidden bg-espresso/15"><span class="block h-full w-full bg-espresso"></span></span>
  </div>
</section>

<script>
  // Arch slideshow: each active progress bar's animation drives the next slide,
  // so hovering (which pauses the animation) also pauses the slideshow.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  function initHero() {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (!hero) return;
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-hero-slide]')];
    const captions = [...hero.querySelectorAll<HTMLElement>('[data-hero-caption]')];
    const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-hero-go]')];
    const index = hero.querySelector('[data-hero-index]');
    let current = 0;

    const show = (next: number) => {
      current = (next + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.toggleAttribute('data-active', active);
        s.tabIndex = active ? 0 : -1;
        s.setAttribute('aria-hidden', String(!active));
      });
      captions.forEach((c, i) => c.classList.toggle('hidden', i !== current));
      tabs.forEach((t, i) => {
        t.setAttribute('aria-selected', String(i === current));
        t.toggleAttribute('data-done', i < current);
      });
      if (index) index.textContent = String(current + 1).padStart(2, '0');
    };

    tabs.forEach((t) => {
      t.addEventListener('click', () => show(Number(t.dataset.heroGo)));
      t.querySelector('.hero-progress')?.addEventListener('animationend', () => {
        if (!reduced.matches && t.getAttribute('aria-selected') === 'true') show(current + 1);
      });
    });
    show(0);
  }

  document.addEventListener('astro:page-load', initHero);
</script>

<style>
  /* Semicircular top (50% of width = 35.7% of a 5:7 height) with soft bottom corners */
  .hero-arch {
    border-radius: 50% 50% 1.75rem 1.75rem / 35.7% 35.7% 1.75rem 1.75rem;
  }

  /* Giant wordmark */
  .hero-mark {
    font-size: clamp(9rem, 31vw, 34rem);
    letter-spacing: 0.06em;
    padding-left: 0.06em;
  }
  .hero-mark span {
    display: inline-block;
  }

  /* Slides: cross-fade with a slow settle-in zoom */
  .hero-slide {
    opacity: 0;
    transition: opacity 1.4s var(--ease-out-expo);
  }
  .hero-slide :global(img) {
    scale: 1.12;
    transition: scale calc(var(--slide-ms) + 1.5s) cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .hero-slide[data-active] {
    opacity: 1;
    z-index: 1;
  }
  .hero-slide[data-active] :global(img) {
    scale: 1;
  }

  /* Progress bars */
  [data-hero-go][aria-selected='true'] .hero-progress {
    animation: hero-progress var(--slide-ms) linear forwards;
  }
  [data-hero-go][data-done] .hero-progress {
    transform: scaleX(1);
  }
  .hero:hover [data-hero-go] .hero-progress {
    animation-play-state: paused;
  }
  @keyframes hero-progress {
    to { transform: scaleX(1); }
  }

  .hero-caption:not(.hidden) {
    animation: var(--animate-fade);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-mark span {
      animation: mark-rise 1.6s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 90ms + 100ms);
    }
    .hero-arch {
      animation: arch-in 1.5s var(--ease-out-expo) both 0.15s;
    }
    .hero-scroll > span {
      animation: scroll-cue 2.2s var(--ease-out-expo) infinite;
    }

    /* Parallax: wordmark drifts up, arch drifts down as you scroll away */
    @supports (animation-timeline: scroll()) {
      .hero-mark {
        animation: drift-up linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .hero-arch {
        animation:
          arch-in 1.5s var(--ease-out-expo) both 0.15s,
          drift-down linear both;
        animation-timeline: auto, scroll(root);
        animation-range: normal, 0 100vh;
      }
    }
  }

  @keyframes mark-rise {
    from { opacity: 0; transform: translateY(40%); }
    to { opacity: 1; transform: none; }
  }
  @keyframes arch-in {
    from { opacity: 0; clip-path: inset(30% 0 0 0 round 50% 50% 1.75rem 1.75rem); translate: 0 40px; }
    to { opacity: 1; clip-path: inset(0 0 0 0 round 0); translate: 0 0; }
  }
  @keyframes scroll-cue {
    from { transform: translateY(-100%); }
    to { transform: translateY(100%); }
  }
  @keyframes drift-up {
    to { transform: translateY(-18%); }
  }
  @keyframes drift-down {
    to { transform: translateY(12%); }
  }
</style>
