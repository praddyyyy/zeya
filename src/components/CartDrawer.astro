---
import WhatsAppIcon from './WhatsAppIcon.astro';
// Slide-in bag with three views: bag → checkout details → "sent to WhatsApp".
// Rendered and driven by src/scripts/drawer.ts; persisted across page navigations.
---

<dialog id="cart" class="drawer drawer-right" aria-labelledby="cart-title" transition:persist="cart">
  <div class="flex h-full flex-col">
    <header class="flex items-center justify-between border-b border-line px-6 py-5">
      <div class="flex items-center gap-3">
        <button type="button" data-cart-back class="-ml-2 hidden rounded-full p-2 hover:bg-sand" aria-label="Back to bag">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <h2 id="cart-title" class="font-serif text-2xl">Your bag</h2>
      </div>
      <button type="button" data-dialog-close class="-mr-2 rounded-full p-2 transition-transform duration-500 hover:rotate-90 hover:bg-sand" aria-label="Close">
        <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </header>

    <!-- Bag -->
    <section data-view="bag" class="flex min-h-0 flex-1 flex-col">
      <ul data-cart-items class="flex-1 divide-y divide-line overflow-y-auto px-6"></ul>
      <div data-cart-empty class="hidden flex-1 flex-col items-center justify-center gap-5 px-8 text-center">
        <svg viewBox="0 0 48 48" class="size-14 text-gold" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M10 16h28l-2 26H12L10 16z"></path><path d="M17 16v-3a7 7 0 0114 0v3"></path></svg>
        <p class="font-serif text-2xl">Your bag is empty</p>
        <p class="text-sm text-muted">Find something you love — we'll keep it here for you.</p>
        <div class="flex gap-3">
          <a href="/women" class="btn btn-outline" data-dialog-close>Shop Women</a>
          <a href="/men" class="btn btn-outline" data-dialog-close>Shop Men</a>
        </div>
      </div>
      <footer data-cart-footer class="border-t border-line bg-cream/60 px-6 py-5">
        <div class="flex items-baseline justify-between">
          <span class="text-sm text-muted">Subtotal</span>
          <span data-cart-subtotal class="font-serif text-2xl"></span>
        </div>
        <p class="mt-1 text-xs text-muted">Delivery and payment are confirmed with you on WhatsApp.</p>
        <button type="button" data-cart-checkout class="btn btn-primary mt-4 w-full">Checkout on WhatsApp</button>
      </footer>
    </section>

    <!-- Checkout details -->
    <!-- data-astro-reload stops the ClientRouter from treating submit as a navigation -->
    <form data-view="checkout" data-astro-reload class="hidden min-h-0 flex-1 flex-col" novalidate>
      <div class="flex-1 space-y-4 overflow-y-auto px-6 py-6">
        <p class="text-sm text-muted">
          Add your details and we'll open WhatsApp with your order ready to send. We'll reply to confirm sizes, delivery and payment.
        </p>
        <div data-checkout-summary class="rounded-2xl bg-cream px-5 py-4 text-sm"></div>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-wide">Full name *</span>
          <input class="field" name="name" autocomplete="name" required maxlength="60" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-wide">Phone number *</span>
          <input class="field" name="phone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9+\s\-]{10,16}" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-wide">City / Pincode *</span>
          <input class="field" name="city" autocomplete="address-level2" required maxlength="60" />
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-wide">Delivery address <span class="font-normal text-muted">(optional)</span></span>
          <textarea class="field resize-none" name="address" rows="2" autocomplete="street-address" maxlength="240"></textarea>
        </label>
        <label class="block">
          <span class="mb-1.5 block text-xs font-semibold tracking-wide">Note <span class="font-normal text-muted">(optional)</span></span>
          <textarea class="field resize-none" name="note" rows="2" maxlength="240" placeholder="Gift wrap, preferred delivery time, measurements…"></textarea>
        </label>
        <p data-checkout-error class="hidden text-sm text-terracotta" role="alert">Please fill in your name, a valid phone number and your city.</p>
      </div>
      <footer class="border-t border-line bg-cream/60 px-6 py-5">
        <button type="submit" class="btn btn-whatsapp w-full">
          <WhatsAppIcon />
          Send order on WhatsApp
        </button>
        <p class="mt-2 text-center text-xs text-muted">Your details are only shared in the WhatsApp message you send.</p>
      </footer>
    </form>

    <!-- Sent -->
    <section data-view="sent" class="hidden flex-1 flex-col items-center justify-center gap-5 px-8 text-center">
      <div class="grid size-16 place-items-center rounded-full bg-whatsapp/10 text-whatsapp">
        <svg viewBox="0 0 24 24" class="size-8" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
      </div>
      <p class="font-serif text-3xl">Almost there!</p>
      <p class="text-sm text-muted">
        Your order is waiting in WhatsApp — just tap <strong>send</strong>. We'll reply shortly to confirm.
      </p>
      <a data-sent-retry href="#" target="_blank" rel="noopener" class="text-sm font-semibold underline underline-offset-4">WhatsApp didn't open? Try again</a>
      <div data-sent-cart-actions class="flex w-full flex-col gap-3 pt-4">
        <button type="button" data-cart-clear class="btn btn-primary w-full">I've sent it — clear my bag</button>
        <button type="button" data-dialog-close class="btn btn-outline w-full">Keep items in bag</button>
      </div>
    </section>
  </div>
</dialog>
